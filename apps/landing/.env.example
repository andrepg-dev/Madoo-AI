# Backend API base URL. Nest backend runs on port 4000 with prefix /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Product app URL. Landing sends authenticated users and pending prompts here.
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3003

# Google OAuth Web client ID. Authorized JavaScript origins must include http://localhost:3001.
# Must match GOOGLE_CLIENT_ID in apps/backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1045426416197-caerjkkajfie6j7789fi72trr35pltop.apps.googleusercontent.com

# Optional GitHub OAuth app client ID.
# Homepage URL: http://localhost:3001
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
# Client secret goes in apps/backend/.env as GITHUB_CLIENT_SECRET.
NEXT_PUBLIC_GITHUB_CLIENT_ID=Ov23lij5ckAEwNtqU2N7
