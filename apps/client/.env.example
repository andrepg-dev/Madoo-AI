# Backend API base URL. The NestJS backend (apps/backend) runs on port 4000 with prefix /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Product app URL. Used to preserve return paths when auth redirects through landing.
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3003

# Landing owns login and registration. Client redirects unauthenticated users here.
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
