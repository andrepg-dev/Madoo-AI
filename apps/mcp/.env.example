# --- MCP server ---
MCP_PORT=4100
MCP_UTM_SOURCE=mcp

# --- Madoo backend (inside docker compose use the service name) ---
MADOO_API_URL=http://backend:4000/api/v1
MADOO_WEB_URL=https://app.madoo.ai
# Shared secret; must match the backend's MADOO_SERVICE_TOKEN.
MADOO_SERVICE_TOKEN=change-me-to-a-long-random-string

# --- Bridge tool (optional; ask_model is hidden if both are empty) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
