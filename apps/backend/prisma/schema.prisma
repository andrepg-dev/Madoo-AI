generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  passwordHash  String?
  emailVerified Boolean   @default(false)
  locale        String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Share-Madoo referral: the user's own short, url-safe share code (lazily
  // generated the first time they open the referral panel) and the user who
  // referred them (set once at signup, never overwritten).
  referralCode     String? @unique
  referredByUserId String?
  referredBy       User?   @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals        User[]  @relation("UserReferrals")

  pendingPrompts           PendingPrompt[]
  memberships              Membership[]
  billingSubscription      BillingSubscription?
  authAccounts             AuthAccount[]
  providerConnections      ProviderConnection[]
  supportTickets           SupportTicket[]
  sentWorkspaceInvites     WorkspaceInvite[]       @relation("WorkspaceInviteInviter")
  acceptedWorkspaceInvites WorkspaceInvite[]       @relation("WorkspaceInviteAcceptedBy")
  communityTemplates       CommunityTemplate[]
  communityTemplateStars   CommunityTemplateStar[]
  referralRewards          ReferralReward[]        @relation("ReferralRewardReferrer")

  @@index([email])
  @@index([referredByUserId])
}

enum AuthProviderKind {
  GOOGLE
  GITHUB
  APPLE
}

model AuthAccount {
  id                String           @id @default(cuid())
  userId            String
  provider          AuthProviderKind
  providerAccountId String
  email             String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum ConnectionProvider {
  GMAIL
  OUTLOOK
}

model ProviderConnection {
  id              String             @id @default(cuid())
  userId          String
  provider        ConnectionProvider
  accessTokenEnc  String             @db.Text
  refreshTokenEnc String?            @db.Text
  expiresAt       DateTime?
  accountEmail    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model PendingPrompt {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  tone      String?
  length    String?
  audience  String?
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcedEmail Email?

  @@index([userId, consumed])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  avatarUrl              String?
  templateCreationReason String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  members             Membership[]
  emails              Email[]
  emailVariants       EmailVariant[]
  templates           Template[]
  emailGenerationRuns EmailGenerationRun[]
  emailChatMessages   EmailChatMessage[]
  emailVfsSnapshots   EmailVfsSnapshot[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  invites             WorkspaceInvite[]

  @@index([slug])
}

enum EmailStatus {
  DRAFT
  GENERATING
  READY
  ERROR
}

enum EmailVisibility {
  PRIVATE
  PUBLIC
}

enum GenerationRunKind {
  INITIAL
  EDIT
}

enum GenerationRunStatus {
  STARTED
  STREAMING
  COMPLETED
  FAILED
}

enum EmailChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailChatKind {
  TEXT
  THINKING
  STATUS
}

enum EmailChatFeedback {
  LIKE
  DISLIKE
}

model Email {
  id          String      @id @default(cuid())
  workspaceId String
  status      EmailStatus @default(DRAFT)

  prompt   String
  tone     String?
  length   String?
  audience String?

  title           String?
  templateId      String?
  templateSavedAt DateTime?

  visibility EmailVisibility @default(PRIVATE)
  publicId   String?         @unique

  starred Boolean @default(false)

  sourcePendingPromptId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template            Template?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourcePendingPrompt PendingPrompt?       @relation(fields: [sourcePendingPromptId], references: [id])
  variants            EmailVariant[]
  generationRuns      EmailGenerationRun[]
  chatMessages        EmailChatMessage[]
  vfsSnapshot         EmailVfsSnapshot?
  supportTickets      SupportTicket[]

  @@index([workspaceId, createdAt])
}

model EmailVariant {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  seq         Int

  subject        String
  componentCode  String  @db.Text
  compiledHtml   String  @db.Text
  variableSchema Json
  previewUrl     String? @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, seq])
  @@index([workspaceId, emailId])
}

model EmailGenerationRun {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  kind        GenerationRunKind

  status GenerationRunStatus @default(STARTED)

  inputTokens              Int?
  cachedTokens             Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?
  latencyMs                Int?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
}

model EmailChatMessage {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  role        EmailChatRole
  kind        EmailChatKind @default(TEXT)
  content     String        @db.Text
  // Public S3 URLs of images the user attached to this turn, so the chat can be
  // restored with its attachments after a reload.
  imageUrls   String[]      @default([])
  feedback    EmailChatFeedback?
  feedbackComment String? @db.Text

  // Response-version group. Assistant rows produced by regenerating the same
  // turn share a groupId so the UI can offer ‹x/y› version navigation.
  groupId String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@index([workspaceId, emailId, role])
  @@index([emailId, groupId])
}

model EmailVfsSnapshot {
  id String @id @default(cuid())

  workspaceId String
  emailId     String @unique

  filePath        String  @default("Email.tsx")
  componentCode   String  @db.Text
  componentHash   String
  sourceVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model Template {
  id String @id @default(cuid())

  workspaceId String
  slug        String
  name        String
  category    String?
  description String?

  componentCode  String @db.Text
  variableSchema Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// A template shared to the global, cross-workspace community gallery.
model CommunityTemplate {
  id String @id @default(cuid())

  name        String
  description String?
  category    String?
  categories  String[] @default([])

  componentCode  String  @db.Text
  compiledHtml   String  @db.Text
  previewUrl     String? @db.Text
  variableSchema Json

  authorUserId  String
  authorName    String?
  sourceEmailId String?

  viewCount Int @default(0)
  useCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User                    @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  stars  CommunityTemplateStar[]

  @@index([createdAt])
}

/// Per-user favorite of a community template.
model CommunityTemplateStar {
  id String @id @default(cuid())

  communityTemplateId String
  userId              String

  createdAt DateTime @default(now())

  communityTemplate CommunityTemplate @relation(fields: [communityTemplateId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityTemplateId, userId])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actorUserId String
  payload     Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, action, createdAt])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum SupportCategory {
  ACCOUNT
  WORKSPACE
  BILLING
  GENERATION
  EXPORT
  OTHER
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id           String              @id @default(cuid())
  workspaceId  String?
  emailId      String?
  userId       String
  contactEmail String
  category     SupportCategory
  subject      String
  message      String              @db.Text
  status       SupportTicketStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  email     Email?     @relation(fields: [emailId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([emailId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WorkspaceInvite {
  id               String    @id @default(cuid())
  workspaceId      String
  email            String?
  role             Role
  token            String    @unique
  invitedByUserId  String
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("WorkspaceInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("WorkspaceInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, email])
  @@index([expiresAt])
}

enum Plan {
  FREE
  BASIC
  MEDIUM
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model BillingSubscription {
  id                   String             @id @default(cuid())
  // Account-wide billing: one subscription per user. AI credits (monthly,
  // daily, and bonus) are a single pool shared across every workspace the user
  // owns — they are NOT renewed per workspace.
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  hasUsedTrial         Boolean            @default(false)
  // Opt-in 7-day trial: the trial is granted at checkout only when explicitly
  // claimed. `hasUsedTrial` still latches once any trial has run to block repeats.
  trialClaimed         Boolean            @default(false)
  // Remaining consumable referral bonus credits. Spent only after the monthly
  // base cap is reached; the daily cap still applies.
  bonusCredits         Int                @default(0)
  // Anchor for the rolling monthly AI-credit window. Reset to now() whenever the
  // plan changes (upgrade/downgrade) so credits refresh immediately; otherwise
  // the window rolls forward one month at a time from this date.
  creditsAnchor        DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([plan, status])
}

/// Idempotent ledger of paid-referral rewards. One row per referred user
/// (`referredUserId` unique) guarantees a referrer is rewarded at most once for
/// the same invitee, even across Stripe webhook re-delivery or resubscribes.
model ReferralReward {
  id             String   @id @default(cuid())
  referrerUserId String
  referredUserId String   @unique
  workspaceId    String
  credits        Int
  createdAt      DateTime @default(now())

  referrer User @relation("ReferralRewardReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
}

/// Pre-signup claims for the opt-in 7-day trial. A visitor enters their email in
/// the landing FAQ to reserve a trial "spot". On login/signup, if the user's
/// email is here, their workspace subscription is marked `trialClaimed` so the
/// pricing drawer offers (and checkout grants) the trial.
model TrialClaim {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
