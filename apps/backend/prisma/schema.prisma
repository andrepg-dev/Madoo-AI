generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  locale        String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pendingPrompts PendingPrompt[]
  memberships    Membership[]

  @@index([email])
}

model PendingPrompt {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  tone      String?
  length    String?
  audience  String?
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcedEmail Email?

  @@index([userId, consumed])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  postalAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Membership[]
  emails             Email[]
  emailVariants      EmailVariant[]
  templates          Template[]
  emailGenerationRuns EmailGenerationRun[]
  emailChatMessages   EmailChatMessage[]
  emailVfsSnapshots   EmailVfsSnapshot[]
  contacts            Contact[]
  tags                Tag[]
  contactTags         ContactTag[]
  segments            Segment[]
  suppressionEntries  SuppressionEntry[]
  contactImportJobs   ContactImportJob[]
  domains             Domain[]
  dnsChecks           DnsCheck[]
  campaigns           Campaign[]
  auditLogs           AuditLog[]
  events              Event[]
  trackedLinks        TrackedLink[]
  billingSubscription BillingSubscription?

  @@index([slug])
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum DnsCheckType {
  SPF
  DKIM
  DMARC
  RETURN_PATH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
}

enum EventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum EmailStatus {
  DRAFT
  GENERATING
  READY
  ERROR
}

enum GenerationRunKind {
  INITIAL
  EDIT
}

enum GenerationRunStatus {
  STARTED
  STREAMING
  COMPLETED
  FAILED
}

enum EmailChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailChatKind {
  TEXT
  THINKING
  STATUS
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINED
}

enum ContactImportJobStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Email {
  id          String      @id @default(cuid())
  workspaceId String
  status      EmailStatus @default(DRAFT)

  prompt   String
  tone     String?
  length   String?
  audience String?

  title           String?
  templateId      String?
  templateSavedAt DateTime?

  sourcePendingPromptId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template              Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourcePendingPrompt   PendingPrompt?      @relation(fields: [sourcePendingPromptId], references: [id])
  variants              EmailVariant[]
  generationRuns        EmailGenerationRun[]
  chatMessages          EmailChatMessage[]
  vfsSnapshot           EmailVfsSnapshot?
  campaigns             Campaign[]

  @@index([workspaceId, createdAt])
}

model EmailVariant {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  seq         Int

  subject        String
  componentCode  String  @db.Text
  compiledHtml   String  @db.Text
  variableSchema Json
  previewUrl     String? @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, seq])
  @@index([workspaceId, emailId])
}

model EmailGenerationRun {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  kind        GenerationRunKind

  status GenerationRunStatus @default(STARTED)

  inputTokens       Int?
  cachedTokens      Int?
  outputTokens      Int?
  cacheCreationInputTokens  Int?
  cacheReadInputTokens      Int?
  latencyMs                 Int?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
}

model EmailChatMessage {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  role        EmailChatRole
  kind        EmailChatKind @default(TEXT)
  content     String        @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@index([workspaceId, emailId, role])
}

model EmailVfsSnapshot {
  id String @id @default(cuid())

  workspaceId String
  emailId     String @unique

  filePath       String @default("Email.tsx")
  componentCode  String @db.Text
  componentHash  String
  sourceVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model Template {
  id String @id @default(cuid())

  workspaceId String
  slug        String
  name        String
  category    String?
  description String?

  componentCode String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Contact {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  firstName   String?
  lastName    String?
  status      ContactStatus @default(ACTIVE)
  customFields Json         @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags      ContactTag[]
  deliveries CampaignDelivery[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ContactTag {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  tagId       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, tagId])
}

model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  query       Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([workspaceId, createdAt])
}

model SuppressionEntry {
  id          String            @id @default(cuid())
  workspaceId String
  email       String
  reason      SuppressionReason
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, reason])
}

model ContactImportJob {
  id            String                 @id @default(cuid())
  workspaceId   String
  status        ContactImportJobStatus @default(UPLOADED)
  totalRows     Int                    @default(0)
  processedRows Int                    @default(0)
  errors        Json                   @default("[]")
  filePath      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Domain {
  id             String       @id @default(cuid())
  workspaceId    String
  hostname       String
  status         DomainStatus @default(PENDING)
  dkimPublicKey  String       @db.Text
  dkimPrivateKey String?      @db.Text
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks    DnsCheck[]

  @@unique([workspaceId, hostname])
  @@index([workspaceId, status])
}

model DnsCheck {
  id          String       @id @default(cuid())
  workspaceId String
  domainId    String
  type        DnsCheckType
  hostname    String
  expected    String       @db.Text
  actual      String?      @db.Text
  ok          Boolean
  checkedAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([workspaceId, domainId, type, checkedAt])
}

model Campaign {
  id           String         @id @default(cuid())
  workspaceId  String
  emailId      String
  segmentId    String
  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  fromName     String
  fromEmail    String
  replyTo      String?
  abTest       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email      Email              @relation(fields: [emailId], references: [id], onDelete: Cascade)
  segment    Segment            @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  deliveries CampaignDelivery[]
  events     Event[]
  trackedLinks TrackedLink[]

  @@index([workspaceId, status, createdAt])
}

model CampaignDelivery {
  id             String                 @id @default(cuid())
  campaignId     String
  contactId      String
  messageId      String?
  status         CampaignDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events   Event[]

  @@index([campaignId, status])
  @@index([contactId])
}

model Event {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String
  contactId   String?
  deliveryId  String?
  type        EventType
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery  CampaignDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([campaignId, type, createdAt])
  @@index([workspaceId, type, createdAt])
  @@index([deliveryId, type])
}

model TrackedLink {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String
  url         String   @db.Text
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([workspaceId, campaignId, clicks])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actorUserId String
  payload     Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, action, createdAt])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum Plan {
  FREE
  STARTER
  GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

model BillingSubscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([plan, status])
}
