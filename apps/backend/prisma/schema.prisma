generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  locale        String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pendingPrompts PendingPrompt[]
  memberships    Membership[]

  @@index([email])
}

model PendingPrompt {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  tone      String?
  length    String?
  audience  String?
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcedEmail Email?

  @@index([userId, consumed])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Membership[]
  emails             Email[]
  emailVariants      EmailVariant[]
  templates          Template[]
  emailGenerationRuns EmailGenerationRun[]
  emailChatMessages   EmailChatMessage[]
  emailVfsSnapshots   EmailVfsSnapshot[]
  contacts            Contact[]
  tags                Tag[]
  contactTags         ContactTag[]
  segments            Segment[]
  suppressionEntries  SuppressionEntry[]
  contactImportJobs   ContactImportJob[]

  @@index([slug])
}

enum EmailStatus {
  DRAFT
  GENERATING
  READY
  ERROR
}

enum GenerationRunKind {
  INITIAL
  EDIT
}

enum GenerationRunStatus {
  STARTED
  STREAMING
  COMPLETED
  FAILED
}

enum EmailChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailChatKind {
  TEXT
  THINKING
  STATUS
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINED
}

enum ContactImportJobStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Email {
  id          String      @id @default(cuid())
  workspaceId String
  status      EmailStatus @default(DRAFT)

  prompt   String
  tone     String?
  length   String?
  audience String?

  title      String?
  templateId String?

  sourcePendingPromptId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template              Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourcePendingPrompt   PendingPrompt?      @relation(fields: [sourcePendingPromptId], references: [id])
  variants              EmailVariant[]
  generationRuns        EmailGenerationRun[]
  chatMessages          EmailChatMessage[]
  vfsSnapshot           EmailVfsSnapshot?

  @@index([workspaceId, createdAt])
}

model EmailVariant {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  seq         Int

  subject        String
  componentCode  String  @db.Text
  compiledHtml   String  @db.Text
  variableSchema Json
  previewUrl     String? @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, seq])
  @@index([workspaceId, emailId])
}

model EmailGenerationRun {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  kind        GenerationRunKind

  status GenerationRunStatus @default(STARTED)

  inputTokens       Int?
  cachedTokens      Int?
  outputTokens      Int?
  cacheCreationInputTokens  Int?
  cacheReadInputTokens      Int?
  latencyMs                 Int?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
}

model EmailChatMessage {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  role        EmailChatRole
  kind        EmailChatKind @default(TEXT)
  content     String        @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@index([workspaceId, emailId, role])
}

model EmailVfsSnapshot {
  id String @id @default(cuid())

  workspaceId String
  emailId     String @unique

  filePath       String @default("Email.tsx")
  componentCode  String @db.Text
  componentHash  String
  sourceVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model Template {
  id String @id @default(cuid())

  workspaceId String
  slug        String
  name        String
  category    String?
  description String?

  componentCode String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Contact {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  firstName   String?
  lastName    String?
  status      ContactStatus @default(ACTIVE)
  customFields Json         @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags      ContactTag[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ContactTag {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  tagId       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, tagId])
}

model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  query       Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model SuppressionEntry {
  id          String            @id @default(cuid())
  workspaceId String
  email       String
  reason      SuppressionReason
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, reason])
}

model ContactImportJob {
  id            String                 @id @default(cuid())
  workspaceId   String
  status        ContactImportJobStatus @default(UPLOADED)
  totalRows     Int                    @default(0)
  processedRows Int                    @default(0)
  errors        Json                   @default("[]")
  filePath      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}
