generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  googleId      String?   @unique
  emailVerified Boolean   @default(false)
  locale        String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pendingPrompts PendingPrompt[]
  memberships    Membership[]

  @@index([email])
}

model PendingPrompt {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  tone      String?
  length    String?
  audience  String?
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcedEmail Email?

  @@index([userId, consumed])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Membership[]
  emails             Email[]
  emailVariants      EmailVariant[]
  templates          Template[]
  emailGenerationRuns EmailGenerationRun[]
  emailChatMessages   EmailChatMessage[]
  emailVfsSnapshots   EmailVfsSnapshot[]

  @@index([slug])
}

enum EmailStatus {
  DRAFT
  GENERATING
  READY
  ERROR
}

enum GenerationRunKind {
  INITIAL
  EDIT
}

enum GenerationRunStatus {
  STARTED
  STREAMING
  COMPLETED
  FAILED
}

enum EmailChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EmailChatKind {
  TEXT
  THINKING
  STATUS
}

model Email {
  id          String      @id @default(cuid())
  workspaceId String
  status      EmailStatus @default(DRAFT)

  prompt   String
  tone     String?
  length   String?
  audience String?

  title      String?
  templateId String?

  sourcePendingPromptId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template              Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourcePendingPrompt   PendingPrompt?      @relation(fields: [sourcePendingPromptId], references: [id])
  variants              EmailVariant[]
  generationRuns        EmailGenerationRun[]
  chatMessages          EmailChatMessage[]
  vfsSnapshot           EmailVfsSnapshot?

  @@index([workspaceId, createdAt])
}

model EmailVariant {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  seq         Int

  subject        String
  componentCode  String  @db.Text
  compiledHtml   String  @db.Text
  variableSchema Json
  previewUrl     String? @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, seq])
  @@index([workspaceId, emailId])
}

model EmailGenerationRun {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  kind        GenerationRunKind

  status GenerationRunStatus @default(STARTED)

  inputTokens       Int?
  cachedTokens      Int?
  outputTokens      Int?
  cacheCreationInputTokens  Int?
  cacheReadInputTokens      Int?
  latencyMs                 Int?

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
}

model EmailChatMessage {
  id String @id @default(cuid())

  workspaceId String
  emailId     String
  role        EmailChatRole
  kind        EmailChatKind @default(TEXT)
  content     String        @db.Text

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@index([workspaceId, emailId, role])
}

model EmailVfsSnapshot {
  id String @id @default(cuid())

  workspaceId String
  emailId     String @unique

  filePath       String @default("Email.tsx")
  componentCode  String @db.Text
  componentHash  String
  sourceVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

model Template {
  id String @id @default(cuid())

  workspaceId String
  slug        String
  name        String
  category    String?
  description String?

  componentCode String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}
