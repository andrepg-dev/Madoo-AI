# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list (3000 = apps/frontend, 3001 = apps/landing, 3003 = apps/client)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# Database (Prisma). For docker compose backend service, DATABASE_URL is overridden in compose
# to use host madoo-db. For running the Nest app directly on your machine against compose DBs, keep localhost here.
DATABASE_URL="postgresql://madoo:madoo@localhost:5432/madoo?schema=public"

# Redis (BullMQ). Overridden to madoo-redis for the compose backend container; use localhost for local nest + compose Redis.
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — same Web client as apps/landing NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Authorized JS origins: http://localhost:3001
GOOGLE_CLIENT_ID=1045426416197-caerjkkajfie6j7789fi72trr35pltop.apps.googleusercontent.com
GOOGLE_SECRET_ID=

# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3003/api/auth/github/callback
# Client ID also goes in apps/client/.env.local as NEXT_PUBLIC_GITHUB_CLIENT_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Apple — requires a paid Apple Developer account (https://developer.apple.com/account)
# APPLE_CLIENT_ID: the Services ID (Identifiers → Services IDs), e.g. com.madoo.web
# Apple requires an https return URL; the Apple button stays hidden in the client until configured.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 private key (Keys section), newlines escaped as \n. Only needed for
# server-side code exchange / token revocation; identity-token login works with APPLE_CLIENT_ID alone.
APPLE_PRIVATE_KEY=

# Sending (Phase 3.B)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL_TO=
APP_URL=http://localhost:3003
# Public backend origin. Used to build email click/open tracking links when TRACKING_URL is not set.
BACKEND_URL=http://localhost:4000
# Public API tracking base URL exposed to email clients. Production example: https://api.yourdomain.com/api/v1
TRACKING_URL=http://localhost:4000/api/v1

# --- Phase 7C: Gmail / Outlook OAuth draft exports ---------------------------
# Encryption key for stored OAuth tokens. Generate with: openssl rand -base64 32
# Falls back to JWT_SECRET if unset (acceptable for local dev only).
TOKEN_ENCRYPTION_KEY=
# Gmail drafts reuse GOOGLE_CLIENT_ID / GOOGLE_SECRET_ID above. In Google Cloud:
# enable the Gmail API and add redirect URI http://localhost:3003/api/connections/gmail/callback.
# gmail.compose is a restricted scope — add yourself as a test user while the app is unverified.
# Microsoft Graph (Outlook drafts) — portal.azure.com → App registrations.
# Redirect URI (Web): http://localhost:3003/api/connections/outlook/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
SENDING_DOMAIN=madooai.com
SEND_THROTTLE_TTL_MS=1000
SEND_THROTTLE_LIMIT=5
CAMPAIGN_SEND_RATE_PER_SECOND=5

# ========================
# STRIPE CONFIGURATION
# ========================
# 1. Your Stripe Secret Key (Starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_...
# 2. Your Webhook Secret (Starts with whsec_... )
# Used to securely verify events coming from Stripe (like successful payments or renewals)
STRIPE_WEBHOOK_SECRET=whsec_...
# 3. Monthly Product Price IDs (Starts with price_...)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
# 4. Annual Product Price IDs (Starts with price_...)
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
