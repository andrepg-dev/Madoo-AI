# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list
CORS_ORIGINS=http://localhost:3000

# Database (Prisma). For docker compose backend service, DATABASE_URL is overridden in compose
# to use host madoo-db. For running the Nest app directly on your machine against compose DBs, keep localhost here.
DATABASE_URL="postgresql://madoo:madoo@localhost:5432/madoo?schema=public"

# Redis (BullMQ). Overridden to madoo-redis for the compose backend container; use localhost for local nest + compose Redis.
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — get a client ID from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs > Web application). Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=

# Sending (Phase 3.B)
RESEND_API_KEY=
APP_URL=http://localhost:3000
# Public backend origin. Used to build email click/open tracking links when TRACKING_URL is not set.
BACKEND_URL=http://localhost:40
00
# Public API tracking base URL exposed to email clients. Production example: https://api.yourdomain.com/api/v1
TRACKING_URL=http://localhost:4000/api/v1
SENDING_DOMAIN=madooai.com
SEND_THROTTLE_TTL_MS=1000
SEND_THROTTLE_LIMIT=5
CAMPAIGN_SEND_RATE_PER_SECOND=5

# ========================
# STRIPE CONFIGURATION
# ========================
# 1. Your Stripe Secret Key (Starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_...
# 2. Your Webhook Secret (Starts with whsec_... )
# Used to securely verify events coming from Stripe (like successful payments or renewals)
STRIPE_WEBHOOK_SECRET=whsec_...
# 3. Monthly Product Price IDs (Starts with price_...)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
# 4. Annual Product Price IDs (Starts with price_...)
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
