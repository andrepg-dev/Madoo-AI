# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list
CORS_ORIGINS=http://localhost:3000

# Database (Prisma) — points at the docker-compose Postgres
DATABASE_URL=postgresql://madoo:madoo@localhost:5432/madoo?schema=public

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — get a client ID from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs > Web application). Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=